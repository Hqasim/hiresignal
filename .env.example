# Copy to .env for local development. Never commit .env.
# Each phase adds the variables it needs (SPEC §7.5, §16).

# API (apps/api)
# live | record | replay. Tests, CI and seeding use replay (SPEC §9.8).
LLM_MODE=replay
# Reported by GET /api/health. CI sets the commit SHA.
GIT_SHA=local
# Port for the local API server (Vite proxies /api to it).
PORT=3000

# Database (local Postgres + pgvector from `npm run db:up`).
# Production (Neon, docs/runbook.md): DATABASE_URL is the hiresignal_app role on the pooled host,
# DATABASE_MIGRATION_URL is the owner on the direct host, both with ?sslmode=verify-full.
DATABASE_URL=postgres://hiresignal:hiresignal@localhost:5433/hiresignal
DATABASE_MIGRATION_URL=postgres://hiresignal:hiresignal@localhost:5433/hiresignal
# Integration tests create and drop a throwaway database per test file on this server.
TEST_DATABASE_URL=postgres://hiresignal:hiresignal@localhost:5433/hiresignal

# Web (apps/web)
# Leave empty locally: Vite proxies /api to the local API.
VITE_API_BASE_URL=
