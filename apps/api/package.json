{
  "name": "@hiresignal/api",
  "version": "0.0.0",
  "private": true,
  "description": "HireSignal HTTP API: Hono on AWS Lambda, hexagonal architecture.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main/local-server.ts",
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "smoke:bundle": "node scripts/smoke-bundle.mjs",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/main/cli/migrate.ts",
    "llm:smoke": "tsx --env-file-if-exists=../../.env src/main/cli/llm-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@hiresignal/contracts": "*",
    "@hono/aws-lambda": "1.0.0",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
